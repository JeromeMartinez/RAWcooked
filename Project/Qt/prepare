#! /bin/sh

if qmake --version >/dev/null 2>&1
then
    qmake $QMAKE_ARG "$@"
elif qmake6 --version >/dev/null 2>&1
then
    qmake6 $QMAKE_ARG "$@"
elif qmake-qt6 --version >/dev/null 2>&1
then
    qmake-qt6 $QMAKE_ARG "$@"
elif qmake-qt5 --version >/dev/null 2>&1
then
    qmake-qt5 $QMAKE_ARG "$@"
elif qmake5 --version >/dev/null 2>&1
then
    qmake5 $QMAKE_ARG "$@"
else
    echo qmake not found, please install Qt development package
    exit 1
fi
